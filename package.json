{
  "name": "pixel-room-portfolio",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build && node scripts/flatten-for-pages.mjs && node scripts/generate-llms-txt.mjs",
    "build:astro": "astro build",
    "preview": "astro preview",
    "lint": "prettier --check . && astro check",
    "test": "node --test --experimental-strip-types",
    "deploy": "npm run build && wrangler pages deploy ./dist --project-name=goblin-town",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.1",
    "firebase": "^12.16.0",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "prettier": "^3.7.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.112.0"
  }
}
