---
import "../styles/global.css";
import "../styles/info.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Contact — Vishal Gurung · Goblin Town</title>
    <meta
      name="description"
      content="Reach Vishal Gurung — email, GitHub (g0GobliN), and Instagram (@goblin01_). Work together, ask about a project, or just say hello."
    />
    <meta name="author" content="Vishal Gurung" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="https://v1.monster/contact/" />
    <meta property="og:site_name" content="Goblin Town" />
    <meta property="og:title" content="Contact — Vishal Gurung · Goblin Town" />
    <meta
      property="og:description"
      content="Email, GitHub, and Instagram — ways to reach Vishal Gurung."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://v1.monster/contact/" />
    <meta property="og:image" content="https://v1.monster/og/goblin-town-og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://v1.monster/og/goblin-town-og.png" />
    <meta name="twitter:title" content="Contact — Vishal Gurung · Goblin Town" />
    <meta
      name="twitter:description"
      content="Email, GitHub, and Instagram — ways to reach Vishal Gurung."
    />
    <meta name="theme-color" content="#0c0610" />
    <link rel="icon" href="/logo/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/logo/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap"
    />
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "@id": "https://v1.monster/contact/#page",
        "url": "https://v1.monster/contact/",
        "name": "Contact — Vishal Gurung · Goblin Town",
        "description": "Ways to reach Vishal Gurung — email, GitHub, and Instagram.",
        "isPartOf": { "@id": "https://v1.monster/#website" },
        "about": { "@id": "https://v1.monster/#person" },
        "inLanguage": "en"
      }
    </script>
  </head>
  <body class="info-body">
    <div class="info-wrapper">
      <div class="info-page info-legal info-inner">
        <nav class="info-legal-nav">
          <a href="/">← Summary</a>
          <a href="/game/">Enter Game</a>
        </nav>
        <article class="info-main">
          <h2 class="info-title">Contact</h2>
          <p class="info-lead">
            If you want to talk about a project, build something together, found a bug, or just want
            to say hi — feel free to message me.
          </p>
          <p>I'm usually around somewhere.</p>

          <h3>Find me here</h3>
          <ul class="info-list">
            <li>
              <strong>Email</strong> —
              <a href="mailto:hello@v1.monster">hello@v1.monster</a><br />
              <span class="small">Probably the easiest way to reach me.</span>
            </li>
            <li>
              <strong>GitHub</strong> —
              <a href="https://github.com/g0GobliN" target="_blank" rel="noopener">g0GobliN</a><br
              />
              <span class="small"
                >My code, experiments, unfinished ideas, and the occasional questionable commit.</span
              >
            </li>
            <li>
              <strong>Instagram</strong> —
              <a href="https://instagram.com/goblin01_" target="_blank" rel="noopener">@goblin01_</a
              ><br />
              <span class="small"
                >Random life stuff, projects, pixel things, and sometimes Tokyo.</span
              >
            </li>
          </ul>

          <h3>You can message me about</h3>
          <p>
            A project, an idea, something weird, or a bug in Goblin Town. You don't really need a
            reason.
          </p>

          <h3>Or find me in Goblin Town</h3>
          <p>
            There's a <strong>Church Gate</strong> inside <a href="/game/">the game</a> — walk up and
            press <strong>ACT</strong>. The slowest way to message me, but the most Goblin Town way.
          </p>
        </article>

        <footer class="info-footer">
          <div class="info-footer-legal">
            <p class="small">© {new Date().getFullYear()} Vishal Gurung. All rights reserved.</p>
            <nav class="info-footer-links" aria-label="Legal">
              <a href="/">Home</a>
              <span aria-hidden="true">·</span>
              <a href="/game/">Enter Game</a>
              <span aria-hidden="true">·</span>
              <a href="/privacy/">Privacy &amp; Cookies</a>
              <span aria-hidden="true">·</span>
              <a href="/terms/">Terms</a>
            </nav>
            <p class="small info-footer-note">No cookies, no trackers — just pixels.</p>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
