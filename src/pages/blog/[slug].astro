---
import "../../styles/global.css";
import "../../styles/entry.css";
import { fetchBlogSsr } from "../../lib/firestore-rest";
import { markdownToHtml } from "../../lib/markdown";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const blog = slug ? await fetchBlogSsr(slug) : null;

const title = blog ? `${blog.title} — Goblin Town` : "Blog — Goblin Town";
const description =
  blog?.tagline ||
  blog?.content?.replace(/[#*`>\[\]]/g, "").slice(0, 155) ||
  "A note from the Goblin Town library.";
const canonical = `https://v1.monster/blog/${slug}/`;
const contentHtml = blog ? markdownToHtml(blog.content || "") : "";
const hasMermaid = contentHtml.includes('class="language-mermaid"');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Goblin Town" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    {blog?.publishedAt && <meta property="article:published_time" content={blog.publishedAt} />}
    {blog?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta property="og:image" content="https://v1.monster/og/goblin-town-og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://v1.monster/og/goblin-town-og.png" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/logo/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/logo/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap"
    />
  </head>
  <body class="entry-body">
    <article class="entry-page" data-slug={slug}>
      <nav class="entry-nav">
        <a href="/">← Summary</a>
        <div class="entry-nav-links">
          <a href="/#blog-list">Library</a>
          <a href="/game/">Enter Game</a>
        </div>
      </nav>
      <div id="entry-root">
        {
          blog ? (
            <div class="entry-body-inner">
              {blog.coverImage && <img class="entry-cover" src={blog.coverImage} alt="" />}
              <p class="entry-kicker">Library</p>
              <h1 class="entry-title">{blog.title}</h1>
              <p class="entry-meta">{blog.publishedAt || ""}</p>
              {blog.tagline && <p class="entry-tagline">{blog.tagline}</p>}
              {blog.tags?.length > 0 && (
                <div class="entry-stack">
                  {blog.tags.map((t) => (
                    <span class="entry-chip">{t}</span>
                  ))}
                </div>
              )}
              <div class="entry-content" set:html={contentHtml} />
              <div class="entry-links">
                <a class="entry-link-btn" href="/#blog-list">
                  More notes
                </a>
                <a class="entry-link-btn primary" href="/game/">
                  Enter Game
                </a>
              </div>
            </div>
          ) : (
            <div class="entry-body-inner">
              <p class="entry-kicker">Library</p>
              <h1 class="entry-title">{slug ? `“${slug}”` : "Library"}</h1>
              <p class="entry-status" data-kind="err">
                {slug
                  ? `No post found for “${slug}”. It may have been moved or renamed — check the library shelf.`
                  : "Missing post slug."}
              </p>
              <div class="entry-links">
                <a class="entry-link-btn" href="/#blog-list">
                  ← Back to Library
                </a>
                <a class="entry-link-btn primary" href="/game/">
                  Enter Game
                </a>
              </div>
            </div>
          )
        }
      </div>
    </article>

    {
      blog && hasMermaid && (
        <script>
          import {renderMermaidBlocks} from "../../lib/mermaid"; const root =
          document.getElementById("entry-root")!; await renderMermaidBlocks(root);
        </script>
      )
    }
  </body>
</html>
