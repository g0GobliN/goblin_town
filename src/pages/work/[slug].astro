---
import "../../styles/global.css";
import "../../styles/entry.css";
import { fetchProjectSsr } from "../../lib/firestore-rest";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const project = slug ? await fetchProjectSsr(slug) : null;

const title = project ? `${project.name || project.slug} — Goblin Town` : "Work — Goblin Town";
const description =
  project?.tagline ||
  project?.summary?.slice(0, 155) ||
  "Project details from Goblin Town workshop.";
const canonical = `https://v1.monster/work/${slug}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Goblin Town" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://v1.monster/og/goblin-town-og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://v1.monster/og/goblin-town-og.png" />
    <meta name="theme-color" content="#000000" />
    {
      project && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "CreativeWork",
            name: project.name || project.slug,
            description: project.tagline || project.summary,
            url: canonical,
            ...(project.coverImage ? { image: project.coverImage } : {}),
            ...(project.year ? { dateCreated: project.year } : {}),
            author: {
              "@type": "Person",
              name: "Vishal Gurung",
              url: "https://v1.monster/",
            },
            ...(project.stack?.length ? { keywords: project.stack.join(", ") } : {}),
          })}
        />
      )
    }
    <link rel="icon" href="/logo/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/logo/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap"
    />
  </head>
  <body class="entry-body">
    <article class="entry-page" data-slug={slug}>
      <nav class="entry-nav">
        <a href="/">← Summary</a>
        <div class="entry-nav-links">
          <a href="/#work-list">Workshop</a>
          <a href="/game/">Enter Game</a>
        </div>
      </nav>
      <div id="entry-root">
        {
          project ? (
            <div class="entry-body-inner">
              {project.coverImage && <img class="entry-cover" src={project.coverImage} alt="" />}
              <p class="entry-kicker">Workshop</p>
              <h1 class="entry-title">{project.name || project.slug}</h1>
              <p class="entry-meta">{[project.year, project.role].filter(Boolean).join(" · ")}</p>
              {project.tagline && <p class="entry-tagline">{project.tagline}</p>}
              {project.stack?.length > 0 && (
                <div class="entry-stack">
                  {project.stack.map((s) => (
                    <span class="entry-chip">{s}</span>
                  ))}
                </div>
              )}
              <div class="entry-content">
                {project.summary && <p set:html={project.summary.replaceAll("\n", "<br />")} />}
              </div>
              {project.highlights?.length > 0 && (
                <ul class="entry-highlights">
                  {project.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              {(project.links?.length || true) && (
                <div class="entry-links">
                  {project.links?.map((l) => (
                    <a class="entry-link-btn" href={l.href} target="_blank" rel="noopener">
                      {l.label || "Link"}
                    </a>
                  ))}
                  <a class="entry-link-btn primary" href="/game/">
                    Enter Game
                  </a>
                </div>
              )}
            </div>
          ) : (
            <div class="entry-body-inner">
              <p class="entry-kicker">Workshop</p>
              <h1 class="entry-title">{slug ? `“${slug}”` : "Workshop"}</h1>
              <p class="entry-status" data-kind="err">
                {slug
                  ? `No project found for “${slug}”. It may have been moved or renamed — check the workshop shelf.`
                  : "Missing project slug."}
              </p>
              <div class="entry-links">
                <a class="entry-link-btn" href="/#work-list">
                  ← Back to Workshop
                </a>
                <a class="entry-link-btn primary" href="/game/">
                  Enter Game
                </a>
              </div>
            </div>
          )
        }
      </div>
    </article>
  </body>
</html>
